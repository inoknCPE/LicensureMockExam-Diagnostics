# Copy this file to .env and replace the placeholder with the private Supabase
# Postgres connection string from the project's Connect panel.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres

# Local development only: use SQLite if Supabase cannot be reached at startup.
# Do not set this on Render; Render's filesystem is not persistent.
CPEDLE_ALLOW_OFFLINE_FALLBACK=true
